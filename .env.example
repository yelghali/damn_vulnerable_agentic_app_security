# ===========================================================================
# Zava Wealth Advisor — environment template
# Copy to `.env` and fill in. NEVER commit a real .env.
# Most values are emitted by `terraform output` (see src/scripts/deploy.ps1).
# ===========================================================================

# --- Lab mode ---------------------------------------------------------------
# OFFLINE_MODE=true lets you run + test the whole app locally with a stub model
# and a local SQLite DB — no Azure resources required. Use for code validation.
OFFLINE_MODE=true

# SECURE_MODE is the master switch. false = the "damn vulnerable" baseline.
# Setting true flips every per-vulnerability toggle below to its secure value.
# During the lab you flip individual toggles module by module instead.
SECURE_MODE=false

# --- Per-vulnerability feature toggles (the teaching artifact) --------------
# Leave unset to inherit from SECURE_MODE. Override one at a time per module.
# ENABLE_CONTENT_SAFETY=false      # V1/V2  Module 1
# ENABLE_PROMPT_SHIELDS=false      # V2     Module 2
# ENABLE_PII_REDACTION=false       # V3     Module 3
# ENABLE_TOOL_LEAST_PRIV=false     # V4     Module 4
# ENABLE_HITL=false                # V4     Module 4
# ENABLE_CODE_SANDBOX=false        # V8     Module 4
# ENABLE_OBO=false                 # V5     Module 5
# ENABLE_DOC_SECURITY=false        # V5     Module 5
# ENABLE_GROUNDEDNESS=false        # V6     Module 2/8
# ENABLE_SECURE_RUNTIME=false      # V7     Module 6
# ENABLE_MCP_TOOL_SECURITY=false   # V9     Module 4
# ENABLE_AI_GATEWAY=false          # V10    Module 6

# --- Tool transport (local vs. MCP) -----------------------------------------
# USE_MCP_TOOLS=true routes the Postgres data tools through an MCP server
# (e.g. the Azure Database for PostgreSQL MCP server) instead of local calls.
USE_MCP_TOOLS=false
PG_MCP_SERVER_URL=
# Comma-separated allow-list of MCP tools each agent may call (secure mode, V9).
MCP_TOOL_ALLOWLIST=get_accounts,get_transactions,get_credit_score

# --- AI gateway (Azure API Management, V10) ---------------------------------
# Base URL of APIM placed in front of the Foundry model + MCP/tool endpoints.
AI_GATEWAY_URL=
# Token budget enforced by the APIM GenAI token-limit policy.
AI_GATEWAY_TOKEN_LIMIT=20000

# --- Azure AI Foundry (project SDK) -----------------------------------------
# Project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Governed model deployment used by the secure path.
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini
# Deployment whose content filters are OFF (simulated "ungoverned" model, V1).
FOUNDRY_UNGOVERNED_DEPLOYMENT=gpt-4o-mini-nofilter

# --- Azure AI Content Safety (V1/V2) ----------------------------------------
CONTENT_SAFETY_ENDPOINT=
# Prefer Entra/managed identity; key only as a fallback for local dev.
CONTENT_SAFETY_KEY=

# --- Azure AI Language — PII (V3) -------------------------------------------
LANGUAGE_ENDPOINT=
LANGUAGE_KEY=

# --- Azure AI Search (RAG, V5/V6) -------------------------------------------
SEARCH_ENDPOINT=
SEARCH_INDEX_NAME=zava-financial-docs
SEARCH_KEY=

# --- Azure Database for PostgreSQL Flexible Server (V4) ---------------------
# VULNERABLE baseline: admin connection string (read/write/DDL). LAB-VULN(V4)
PG_ADMIN_CONNECTION=postgresql://zavaadmin:CHANGEME@localhost:5432/zava
# SECURE: least-privilege, read-only app role used once V4 is remediated.
PG_APP_CONNECTION=postgresql://zava_app_ro:CHANGEME@localhost:5432/zava

# --- Microsoft Entra ID (OBO/RBAC, V5) --------------------------------------
AZURE_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_CLIENT_SECRET=
ENTRA_API_SCOPE=

# --- Key Vault (V5) ---------------------------------------------------------
KEY_VAULT_URI=

# --- Monitoring (V7) --------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
