# ===========================================================================
# Zava Wealth Advisor — environment template
# Copy to `.env` and fill in. NEVER commit a real .env.
# Most values are emitted by `terraform output` (see src/scripts/deploy.ps1).
# ===========================================================================

# --- Lab mode ---------------------------------------------------------------
# OFFLINE_MODE=true runs the whole app locally against a REAL small language
# model (via Microsoft Foundry Local) and a local SQLite DB — no Azure resources
# and no cost. OFFLINE_MODE=false sends the same calls to Azure AI Foundry.
OFFLINE_MODE=true
# Keep seeded SQLite data tools while using a remote Foundry model locally.
LOCAL_DATA_MODE=false

# --- Local SLM (offline backend) --------------------------------------------
# Default: Foundry Local auto-discovers the endpoint+model. First, install it:
#   winget install Microsoft.FoundryLocal   (or: brew install foundrylocal)
#   foundry model run phi-3.5-mini
# LOCAL_MODEL_NAME selects the Foundry Local model alias.
LOCAL_MODEL_NAME=phi-3.5-mini
# To use any other OpenAI-compatible server (e.g. Ollama) set its endpoint here
# and LOCAL_MODEL_NAME to that server's model id. Leave blank to use Foundry Local.
#   LOCAL_MODEL_ENDPOINT=http://localhost:11434/v1
#   LOCAL_MODEL_NAME=phi3.5
LOCAL_MODEL_ENDPOINT=
LOCAL_MODEL_KEY=
# Normal lab runs require a real local/cloud model. The deterministic stub is
# only for automated tests or emergency demos when explicitly enabled.
ALLOW_STUB_MODEL=false

# SECURE_MODE is the master switch. false = the "damn vulnerable" baseline.
# Setting true flips every per-vulnerability toggle below to its secure value.
# During the lab you flip individual toggles module by module instead.
SECURE_MODE=false

# --- Per-vulnerability feature toggles (the teaching artifact) --------------
# Leave unset to inherit from SECURE_MODE. Override one at a time per module.
# ENABLE_CONTENT_SAFETY=false      # V1/V2  Module 1
# ENABLE_PROMPT_SHIELDS=false      # V2     Module 2
# ENABLE_PII_REDACTION=false       # V3     Module 3
# ENABLE_TOOL_LEAST_PRIV=false     # V4     Module 4
# ENABLE_HITL=false                # V4     Module 4
# ENABLE_CODE_SANDBOX=false        # V8     Module 4
# ENABLE_OBO=false                 # V5     Module 5
# ENABLE_DOC_SECURITY=false        # V5     Module 5
# ENABLE_GROUNDEDNESS=false        # V6     Module 2/8
# ENABLE_SECURE_RUNTIME=false      # V7     Module 6
# ENABLE_MCP_TOOL_SECURITY=false   # V9     Module 4
# ENABLE_AI_GATEWAY=false          # V10    Module 6
# ENABLE_A2A_GUARD=false           # V11    Module 4 (agent-to-agent message guard)

# --- Content Safety guardrail tuning (Module 1) — only while ENABLE_CONTENT_SAFETY=true
# Mirrors the Azure Content Safety portal: each guardrail aspect is tuned
# separately, not one on/off switch.
#   Global harm-severity threshold 1..7 (lower = stricter; blocks at/above it).
# CONTENT_SAFETY_SEVERITY_THRESHOLD=2
#   Per-category overrides for the 4 Azure harm categories — each its own slider
#   (like the portal). Unset -> inherit the global threshold above.
# CONTENT_SAFETY_THRESHOLD_HATE=2
# CONTENT_SAFETY_THRESHOLD_SEXUAL=2
# CONTENT_SAFETY_THRESHOLD_VIOLENCE=2
# CONTENT_SAFETY_THRESHOLD_SELF_HARM=2
#   Custom category (off-topic/politics) — an org rule, not a harm category.
#   Alternatively scope it away in the secure system prompt. Default on.
# CONTENT_SAFETY_BLOCK_OFF_TOPIC=true

# --- Tool transport (local vs. MCP) -----------------------------------------
# USE_MCP_TOOLS=true routes the Postgres data tools through an MCP server
# (the Microsoft Azure MCP Server, postgres namespace, hosted on Azure
# Container Apps by infra/containerapp.tf) instead of local calls.
USE_MCP_TOOLS=false
# Remote MCP endpoint of the Microsoft Azure MCP Server (Terraform output
# pg_mcp_server_url), e.g. https://ca-azmcp-<suffix>.<region>.azurecontainerapps.io/mcp
PG_MCP_SERVER_URL=
# Comma-separated allow-list of MCP tools each agent may call (secure mode, V9).
MCP_TOOL_ALLOWLIST=get_accounts,get_transactions,get_credit_score

# --- AI gateway (Azure API Management, V10) ---------------------------------
# Base URL of APIM placed in front of the Foundry model + MCP/tool endpoints.
AI_GATEWAY_URL=
# Token budget enforced by the APIM GenAI token-limit policy.
AI_GATEWAY_TOKEN_LIMIT=20000
# Optional paired app links shown in the hosted web UI for browser-only learners.
VULNERABLE_APP_URL=
SECURE_APP_URL=

# --- Azure AI Foundry (project SDK) -----------------------------------------
# Project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Base model behind the deployment name, shown in the UI for clarity.
FOUNDRY_MODEL_NAME=gpt-4.1-mini
# Governed model deployment used by the secure path.
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini
# Deployment whose content filters are OFF (simulated "ungoverned" model, V1).
FOUNDRY_UNGOVERNED_DEPLOYMENT=gpt-4.1-mini-nofilter
# Persistent Foundry agents (visible in the portal Agents tab). Provision with
# `python -m src.scripts.provision_foundry_agents`.
PROVISION_FOUNDRY_AGENTS=false
# Project connection names used by the agent tools (create in the portal /
# `az cognitiveservices account project connection create`).
SEARCH_CONNECTION_NAME=zava-search
PG_MCP_CONNECTION_NAME=zava-postgres-mcp

# --- Azure AI Content Safety (V1/V2) ----------------------------------------
CONTENT_SAFETY_ENDPOINT=
# Prefer Entra/managed identity; key only as a fallback for local dev.
CONTENT_SAFETY_KEY=

# --- Azure AI Language — PII (V3) -------------------------------------------
LANGUAGE_ENDPOINT=
LANGUAGE_KEY=

# --- Azure AI Search (RAG, V5/V6) -------------------------------------------
SEARCH_ENDPOINT=
SEARCH_INDEX_NAME=zava-financial-docs
SEARCH_KEY=

# --- Azure Database for PostgreSQL Flexible Server (V4) ---------------------
# VULNERABLE baseline: admin connection string (read/write/DDL). LAB-VULN(V4)
PG_ADMIN_CONNECTION=postgresql://zavaadmin:CHANGEME@localhost:5432/zava
# SECURE: least-privilege, read-only app role used once V4 is remediated.
PG_APP_CONNECTION=postgresql://zava_app_ro:CHANGEME@localhost:5432/zava

# --- Microsoft Entra ID (OBO/RBAC, V5) --------------------------------------
AZURE_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_CLIENT_SECRET=
ENTRA_API_SCOPE=

# --- Key Vault (V5) ---------------------------------------------------------
KEY_VAULT_URI=

# --- Monitoring (V7) --------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
